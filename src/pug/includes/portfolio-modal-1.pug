// Portfolio item 1 modal popup
#portfolioModal1.portfolio-modal.modal.fade(tabindex='-1', role='dialog', aria-hidden='true')
    .modal-dialog
        .modal-content
            .close-modal(data-bs-dismiss='modal')
                img(src='assets/img/close-icon.svg', alt='Close modal')
            .container
                .row.justify-content-center
                    .col-lg-8
                        .modal-body
                            // Project details
                            h2.text-uppercase Granite Countertop
                            p.item-intro.text-muted Modern kitchen remodeling.
                            img.img-fluid.d-block.mx-auto(src='assets/img/portfolio/1.jpg', alt='...')
                            p In this project, we completely renovated the condo, transforming it into a modern and functional space. The kitchen was updated with custom-made cabinets, a granite countertop, a porcelain backsplash, new appliances, and integrated light fixtures. We also remodeled two bathrooms, replaced the flooring throughout the condo, and installed new interior doors. In addition, we removed the popcorn ceiling and replaced it with a smooth finish, installed new baseboards, and finished the walls, ceilings, and doors with fresh paint.
                            ul.list-inline
                                li
                                    strong Client:
                                    | Tatiana Montiel
                                li
                                    strong Category:
                                    | Complete condo remodeling
                            button.btn.btn-primary.btn-xl.text-uppercase(data-bs-dismiss='modal', type='button')
                                i.fas.fa-xmark.me-1
                                | Close Project